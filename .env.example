# Database: a local SQLite file for development, or a Turso (libSQL) URL in production.
DATABASE_URL=file:./data/genaan.db
# Only needed for Turso: the database auth token.
DATABASE_AUTH_TOKEN=

# Signs admin session cookies. Use a long random value, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# First admin account, created by `npm run db:seed` or reset by `npm run admin:create`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
